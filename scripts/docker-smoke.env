# Variables FALSAS para la prueba de humo de la imagen Docker (scripts/docker-smoke.sh).
# Ninguna es real ni da acceso a nada. La app arranca sin conectarse a la BD:
# `pg` abre la conexión recién con la primera consulta, y GET / no consulta nada.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://smoke:smoke@127.0.0.1:5999/smoke
SUPABASE_URL=https://smoke.supabase.co
SUPABASE_ANON_KEY=smoke-anon-not-real
SUPABASE_SERVICE_ROLE_KEY=smoke-service-not-real
MATEO_HANDOFF_SECRET=smoke-handoff-not-real-0001
MATEO_WIDGET_JWT_SECRET=smoke-widget-not-real-0002
MATEO_ALLOWED_ORIGINS=http://localhost:5173
